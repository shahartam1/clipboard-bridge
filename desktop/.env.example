# Copy this file to .env and set the server URL for your setup.

# On the Mac that runs the server (default — never breaks on IP change):
VITE_SERVER_URL=ws://localhost:8787

# On a Windows/other device connecting to the Mac over Wi-Fi,
# replace with the Mac's current local IP (run `ipconfig getifaddr en0` on Mac):
# VITE_SERVER_URL=ws://192.168.1.117:8787
